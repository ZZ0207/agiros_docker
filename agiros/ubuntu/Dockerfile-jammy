# syntax=docker/dockerfile:1.4
#
# Ubuntu Jammy (22.04) + agiros loong for multi-arch (amd64/arm64).
# Note: If you encounter network errors, you can remove the syntax line above
# and use standard Dockerfile syntax instead.
# Build with:
#   docker buildx build --platform linux/amd64,linux/arm64 -t <name>:loong-ubuntu -f agiros/ubuntu/Dockerfile-jammy .
#

ARG UBUNTU_TAG=22.04
FROM ubuntu:${UBUNTU_TAG}

SHELL ["/bin/bash", "-c"]

ARG ROS_DISTRO=loong
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}
ARG AGIROS_INSTALL_URL=http://1.94.193.239/debrepo/agiros/ubuntu2204lts/2512/install.sh

# docker buildx will set this automatically (amd64/arm64)
ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC \
    DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DISTRO=${ROS_DISTRO} \
    AGIROS_INSTALL_BASE=${AGIROS_INSTALL_BASE}

WORKDIR /root

# Copy repo `src/` into the image user's $HOME/src (root -> /root/src)
# Note: Submodules (unitree_sdk2, unitree_ros2) should be initialized before building.
# In CI/CD (GitHub Actions/Gitee Go), submodules are auto-fetched via checkout action.
# For local builds, run: git submodule update --init --recursive
RUN set -euxo pipefail; \
    mkdir -p /root/src
COPY src/ /root/src/

# Base build tooling + common ROS2 deps
RUN set -euxo pipefail; \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      wget \
      git \
      findutils \
      tar \
      gzip \
      bzip2 \
      unzip \
      make \
      cmake \
      ninja-build \
      gcc \
      g++ \
      pkg-config \
      python3 \
      python3-pip \
      python3-dev \
      python3-numpy \
      python3-lxml \
      libssl-dev \
      libffi-dev \
      libyaml-dev \
      uuid-dev \
      libxml2-dev \
      libtinyxml2-dev \
      libcurl4-openssl-dev \
      libsqlite3-dev \
      libyaml-cpp-dev \
      libasound2-dev \
      libpcap-dev \
      && apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python build
RUN set -euxo pipefail; \
    python3 -m pip install --no-cache-dir -U pip setuptools wheel; \
    python3 -m pip install --no-cache-dir -U \
      colcon-common-extensions \
      colcon-mixin \
      colcon-ros \
      vcstool \
      empy \
      catkin_pkg \
      lark \
      pyyaml \
      pytest

# Install agiros
# Note: ntpdate may fail in Docker containers (Operation not permitted), but this is non-fatal
# We run the install script and check if AGIROS was actually installed, ignoring ntpdate errors
RUN set -euxo pipefail; \
    curl -fsSL "${AGIROS_INSTALL_URL}" -o install.sh; \
    chmod +x install.sh; \
    sed -i 's#</dev/tty#</dev/stdin#g' install.sh; \
    set +e; \
    printf "2\n" | bash ./install.sh > /tmp/install.log 2>&1; \
    INSTALL_EXIT=$?; \
    set -e; \
    if [ $INSTALL_EXIT -ne 0 ]; then \
      if grep -q "Can't adjust the time of day: Operation not permitted" /tmp/install.log; then \
        echo "⚠ ntpdate error detected (non-fatal in containers), checking if AGIROS was installed..."; \
        if [ -d "${AGIROS_INSTALL_BASE}" ] || [ -d "/opt/agiros" ]; then \
          echo "✓ AGIROS appears to be installed despite ntpdate error"; \
        else \
          echo "✗ AGIROS installation failed"; \
          cat /tmp/install.log; \
          exit 1; \
        fi; \
      else \
        echo "✗ AGIROS installation failed with exit code $INSTALL_EXIT"; \
        cat /tmp/install.log; \
        exit 1; \
      fi; \
    fi; \
    rm -f install.sh /tmp/install.log

# ===== GStreamer =====
RUN set -euxo pipefail; \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      libgirepository1.0-dev \
      libcairo2-dev \
      gir1.2-gtk-3.0 \
      libgstreamer1.0-dev \
      libgstreamer-plugins-base1.0-dev \
      libgstreamer-plugins-good1.0-dev \
      gir1.2-gstreamer-1.0 \
      && apt-get clean && \
    rm -rf /var/lib/apt/lists/*
# Install PyGObject using pip
RUN python3 -m pip install --no-cache-dir PyGObject
# Run test file to check if PyGObject is installed correctly
WORKDIR /root/src
RUN python3 /root/src/tests/test_gi.py
# ===== GStreamer =====

# ===== Installing unitree_sdk2 =====
# Build the Unitree SDK:
# Change to the unitree_sdk2 folder, make install.sh executable and run it,
# then create a build directory, run cmake and make.
# Note: unitree_sdk2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "⚠ unitree_sdk2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_sdk2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_sdk2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_sdk2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2; \
      fi; \
    fi; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "✗ unitree_sdk2/CMakeLists.txt not found after initialization"; \
      ls -la unitree_sdk2/ || true; \
      exit 1; \
    fi; \
    echo "✓ unitree_sdk2 submodule ready"

WORKDIR /root/src/unitree_sdk2
RUN mkdir build && \
    cd build && \
    cmake .. && \
    make install
# ===== Installing unitree_sdk2 =====

# ===== Installing unitree_ros2 =====
# Following https://github.com/unitreerobotics/unitree_ros2
# To get unitree_ros2 installed.
# Note: unitree_ros2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -d "unitree_ros2" ] || ([ ! -f "unitree_ros2/.git" ] && [ ! -d "unitree_ros2/.git" ]); then \
      echo "⚠ unitree_ros2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_ros2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_ros2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_ros2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2; \
      fi; \
    fi; \
    if [ ! -d "unitree_ros2" ]; then \
      echo "✗ unitree_ros2 directory not found after initialization"; \
      exit 1; \
    fi; \
    echo "✓ unitree_ros2 submodule ready"

WORKDIR /root/src/unitree_ros2/cyclonedds_ws/src
RUN git clone https://github.com/ros2/rmw_cyclonedds -b humble && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    colcon build --packages-select cyclonedds

# Now, source the ROS2 environment and build the rest of the packages,
# skipping cyclone‑dds (which has already been built)
WORKDIR /root/src/unitree_ros2/cyclonedds_ws
# 修改默认的setup.sh文件，拷贝到/root/src/unitree_ros2/cyclonedds_ws/install/setup.bash
RUN set -euxo pipefail; \
    if [ -f /root/src/agiros_cyclonedds_setup.sh ]; then \
      cp /root/src/agiros_cyclonedds_setup.sh /root/src/unitree_ros2/setup.sh; \
      chmod +x /root/src/unitree_ros2/setup.sh; \
    else \
      echo "✗ /root/src/agiros_cyclonedds_setup.sh not found"; \
      ls -la /root/src/agiros_cyclonedds_setup.sh || true; \
      exit 1; \
    fi


# Install ROS2 development packages that may not be included in AGIROS
# AGIROS is based on ROS2 Humble, so we can install missing packages from standard ROS2 repos
# This must be done after AGIROS installation to ensure ROS2 repos are configured
RUN set -euxo pipefail; \
    echo "=== 安装ROS2开发包 ==="; \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      agiros-${ROS_DISTRO}-rosidl-generator-dds-idl \
      agiros-${ROS_DISTRO}-rosidl-generator-c \
      agiros-${ROS_DISTRO}-rosidl-generator-cpp \
      agiros-${ROS_DISTRO}-rosidl-typesupport-c \
      agiros-${ROS_DISTRO}-rosidl-typesupport-cpp \
      agiros-${ROS_DISTRO}-rosidl-typesupport-introspection-c \
      agiros-${ROS_DISTRO}-rosidl-typesupport-introspection-cpp \
      agiros-${ROS_DISTRO}-builtin-interfaces || \
    (echo "⚠ 某些agiros包安装失败，继续..." && true); \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*;

# Initialize agirosdep and install package dependencies
RUN bash -c "set -exo pipefail; \
    set +u; \
    source /opt/agiros/${ROS_DISTRO}/setup.bash; \
    set -u; \
    agirosdep init 2>/dev/null || true; \
    agirosdep update; \
    agirosdep install --from-paths src --ignore-src -r -y \
      --skip-keys 'cyclonedds rmw_cyclonedds_cpp' || \
    (echo '⚠ agirosdep install failed or some packages unavailable, continuing...' && true)"

# Build unitree_ros2 packages
RUN bash -c "source /opt/agiros/${ROS_DISTRO}/setup.bash && \
            pwd && \
            colcon build"
# Double check whether the build was successful
RUN ls -l /root/src/unitree_ros2/cyclonedds_ws
# ===== Installing unitree_ros2 =====

# Default ROS environment for interactive shells
RUN set -euxo pipefail; \
    echo "source ${AGIROS_INSTALL_BASE}/setup.bash" >> /etc/bashrc

ENV ROS_ROOT=${AGIROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    ROS_INSTALL_BASE=${AGIROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${AGIROS_INSTALL_BASE}/lib:${AGIROS_INSTALL_BASE}/lib64:${LD_LIBRARY_PATH:-} \
    PATH=${AGIROS_INSTALL_BASE}/bin:${PATH}

CMD ["/bin/bash"]
