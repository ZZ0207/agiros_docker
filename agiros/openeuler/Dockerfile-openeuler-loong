# syntax=docker/dockerfile:1.4
#
# openEuler + agiros loong  for multi-arch (amd64/arm64).
# Note: If you encounter network errors, you can remove the syntax line above
# and use standard Dockerfile syntax instead.
# Build with:
#   docker buildx build --platform linux/amd64,linux/arm64 -t <name>:loong-openeuler -f agiros/openeuler/Dockerfile-openeuler-loong .
#
# Notes:
# - ROS 2 binaries are not officially released for openEuler, so we build from source.
# - Dependency resolution via rosdep may not fully match openEuler; this Dockerfile attempts rosdep and continues.
#

ARG OPENEULER_TAG=24.03-lts
FROM openeuler/openeuler:${OPENEULER_TAG}

SHELL ["/bin/bash", "-c"]

ARG ROS_DISTRO=loong
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}
ARG AGIROS_INSTALL_URL=http://1.94.193.239/yumrepo/agiros/openeuler2403lts/2512/install.sh

# docker buildx will set this automatically (amd64/arm64)
ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DISTRO=${ROS_DISTRO} \
    AGIROS_INSTALL_BASE=${AGIROS_INSTALL_BASE}

WORKDIR /root

# Copy repo `src/` into the image user's $HOME/src (root -> /root/src)
# Note: Submodules (unitree_sdk2, unitree_ros2) should be initialized before building.
# In CI/CD (GitHub Actions/Gitee Go), submodules are auto-fetched via checkout action.
# For local builds, run: git submodule update --init --recursive
RUN set -euxo pipefail; \
    mkdir -p /root/src
COPY src/ /root/src/

# Base build tooling + common ROS2 deps (RPM names are "RHEL-like"; some may vary by openEuler release).
RUN set -euxo pipefail; \
    dnf -y update; \
    dnf -y install \
      bash \
      ca-certificates \
      curl \
      wget \
      git \
      which \
      findutils \
      tar \
      gzip \
      bzip2 \
      unzip \
      make \
      cmake \
      ninja-build \
      gcc \
      gcc-c++ \
      pkgconf-pkg-config \
      python3 \
      python3-pip \
      python3-devel \
      python3-numpy \
      python3-lxml \
      openssl-devel \
      libffi-devel \
      libyaml-devel \
      libuuid-devel \
      libxml2-devel \
      tinyxml2-devel \
      libcurl-devel \
      sqlite-devel \
      yaml-cpp-devel \
      alsa-lib-devel \
      libpcap-devel \
      && dnf clean all; \
    rm -rf /var/cache/dnf

# Python build
RUN set -euxo pipefail; \
    python3 -m pip install --no-cache-dir -U pip setuptools wheel; \
    python3 -m pip install --no-cache-dir -U \
      colcon-common-extensions \
      colcon-mixin \
      colcon-ros \
      vcstool \
      empy \
      catkin_pkg \
      lark \
      pyyaml \
      pytest


# Install agiros
RUN set -euxo pipefail; \
    curl -fsSL "${AGIROS_INSTALL_URL}" -o install.sh; \
    chmod +x install.sh; \
    sed -i 's#</dev/tty#</dev/stdin#g' install.sh; \
    printf "2\n" | bash ./install.sh; \
    rm install.sh



# ===== GStreamer =====
# Install GStreamer + GI bindings from system packages.
# Rationale:
# - Installing PyGObject via pip pulls in pycairo built with meson+ninja, which conflicts with openEuler's python3-ninja/ninja-build packaging.
# - System packages are sufficient for `gi` + GStreamer usage (tests/test_gi.py).
RUN set -euxo pipefail; \
    dnf config-manager --add-repo https://repo.openeuler.org/openEuler-24.03-LTS/OS/${TARGETARCH} && \
    dnf clean all && dnf makecache && \
    dnf -y install \
      gobject-introspection \
      gobject-introspection-devel \
      python3-gobject \
      python3-cairo \
      gstreamer1 \
      gstreamer1-plugins-base \
      gstreamer1-plugins-good \
      && dnf clean all; \
    rm -rf /var/cache/dnf
# Verify python3-gobject installation and ensure gi module is accessible
# On openEuler, python3-gobject installs gi to /usr/lib64/python3.x/site-packages or /usr/lib/python3.x/site-packages
RUN set -euxo pipefail; \
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')"); \
    echo "Python version: $PYTHON_VERSION"; \
    rpm -q python3-gobject || (echo "✗ python3-gobject not installed" && exit 1); \
    if python3 -c "import gi; print('✓ gi module available')" 2>&1; then \
      echo "PyGObject working correctly"; \
    else \
      echo "gi module not in default path, checking locations..."; \
      GI_LOCATIONS=$(find /usr/lib* -path "*/python${PYTHON_VERSION}/site-packages/gi" -type d 2>/dev/null | head -3); \
      if [ -n "$GI_LOCATIONS" ]; then \
        echo "Found gi at: $GI_LOCATIONS"; \
        for loc in $GI_LOCATIONS; do \
          python3 -c "import sys; sys.path.insert(0, '$(dirname $loc)'); import gi; print('✓ gi module found at $(dirname $loc)')" && break; \
        done || (echo "✗ Failed to import gi from found locations" && exit 1); \
      else \
        echo "✗ gi module not found in standard locations"; \
        find /usr -name "gi" -type d 2>/dev/null | head -5; \
        exit 1; \
      fi; \
    fi
# Run test file to check if PyGObject is installed correctly
# Ensure PYTHONPATH includes standard site-packages directories
WORKDIR /root/src
RUN set -euxo pipefail; \
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')"); \
    export PYTHONPATH="/usr/lib64/python${PYTHON_VERSION}/site-packages:/usr/lib/python${PYTHON_VERSION}/site-packages:${PYTHONPATH:-}"; \
    python3 /root/src/tests/test_gi.py
# ===== GStreamer =====


# ===== Installing unitree_sdk2 =====
# Build the Unitree SDK:
# Change to the unitree_sdk2 folder, make install.sh executable and run it,
# then create a build directory, run cmake and make.
WORKDIR /root/src/unitree_sdk2
RUN mkdir build && \
    cd build && \
    cmake .. && \
    sudo make install
# ===== Installing unitree_sdk2 =====


# ===== Installing unitree_ros2 =====
# Following https://github.com/unitreerobotics/unitree_ros2
# To get unitree_ros2 installed.
WORKDIR /root/src/unitree_ros2/cyclonedds_ws/src
RUN git clone https://github.com/ros2/rmw_cyclonedds -b ${ROS_DISTRO} && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    colcon build --packages-select cyclonedds

# Now, source the ROS2 environment and build the rest of the packages,
# skipping cyclone‑dds (which has already been built)
WORKDIR /root/src/unitree_ros2/cyclonedds_ws
#修改默认的setup.sh文件，拷贝到/root/src/unitree_ros2/cyclonedds_ws/install/setup.bash
RUN cp agiros/agiros_cyclonedds_setup.sh /root/src/unitree_ros2/setup.sh && chmod +x /root/src/unitree_ros2/setup.sh
RUN bash -c "source /opt/agiros/${ROS_DISTRO}/setup.bash && \
             pwd && \
             colcon build"
# Double check whether the build was successful
RUN ls -l /root/src/unitree_ros2/cyclonedds_ws
# ===== Installing unitree_ros2 =====


# Default ROS environment for interactive shells
RUN set -euxo pipefail; \
    echo "source ${AGIROS_INSTALL_BASE}/setup.bash" >> /etc/bashrc

ENV ROS_ROOT=${AGIROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${AGIROS_INSTALL_BASE}/lib:${AGIROS_INSTALL_BASE}/lib64 \
    PATH=${AGIROS_INSTALL_BASE}/bin:${PATH}

CMD ["/bin/bash"]


