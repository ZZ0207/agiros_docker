# syntax=docker/dockerfile:1.4
ARG OPENEULER_TAG=24.03-lts
FROM openeuler/openeuler:${OPENEULER_TAG}

# 修复1：正确设置bash严格模式（原SHELL指令语法错误）
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]

ARG ROS_DISTRO=loong
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}
ARG AGIROS_INSTALL_URL=http://1.94.193.239/yumrepo/agiros/openeuler2403lts/2512/install.sh
ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DISTRO=${ROS_DISTRO} \
    AGIROS_INSTALL_BASE=${AGIROS_INSTALL_BASE}

WORKDIR /root
COPY src/ /root/src/

# ==================== 系统配置与基础工具链 ====================
RUN dnf -y update && \
    # 修复2：简化仓库配置逻辑
    if ! grep -q "^\[OS\]" /etc/yum.repos.d/*.repo 2>/dev/null; then \
      ARCH=$(uname -m); \
      printf '[OS]\nname=openEuler-24.03-LTS-OS\nbaseurl=https://repo.openeuler.org/openEuler-24.03-LTS/OS/%s/\nenabled=1\ngpgcheck=1\ngpgkey=https://repo.openeuler.org/openEuler-24.03-LTS/OS/%s/RPM-GPG-KEY-openEuler\n\n' "$ARCH" "$ARCH" > /etc/yum.repos.d/openEuler.repo; \
    fi && \
    # 修复3：禁用弱依赖减少体积，合并安装
    dnf -y install --setopt=install_weak_deps=0 \
      bash ca-certificates curl wget git which findutils \
      tar gzip bzip2 unzip make cmake ninja-build \
      gcc gcc-c++ pkgconf-pkg-config \
      python3 python3-pip python3-devel python3-numpy python3-lxml \
      openssl-devel libffi-devel libyaml-devel libuuid-devel \
      libxml2-devel tinyxml2-devel libcurl-devel sqlite-devel \
      yaml-cpp-devel alsa-lib-devel libpcap-devel && \
    dnf clean all && rm -rf /var/cache/dnf && \
    python3 -m pip install --no-cache-dir -U \
      pip setuptools wheel \
      colcon-common-extensions colcon-mixin colcon-ros \
      vcstool empy catkin_pkg lark pyyaml pytest

# ==================== 安装agiros ====================
RUN curl -fsSL "${AGIROS_INSTALL_URL}" -o install.sh && \
    chmod +x install.sh && \
    sed -i 's#</dev/tty#</dev/stdin#g' install.sh && \
    printf "2\n" | bash ./install.sh && \
    rm -f install.sh

# ==================== GStreamer + PyGObject（核心修复） ====================
# 修复4：增强冲突包移除逻辑，使用通配符匹配
RUN dnf -y remove gst-plugins-base-libs* 2>/dev/null || true && \
    dnf -y install --allowerasing \
      gobject-introspection gobject-introspection-devel \
      python3-cairo gstreamer1 gstreamer1-plugins-base gstreamer1-plugins-good \
      libffi-devel cairo-devel pkgconf-pkg-config && \
    # 修复5：简化python3-gobject安装回退逻辑
    if ! dnf -y install python3-gobject 2>/dev/null; then \
      echo "⚠ python3-gobject not in repos, installing via pip..." >&2; \
      python3 -m pip install --no-cache-dir PyGObject; \
    fi && \
    dnf clean all && rm -rf /var/cache/dnf

# 修复6：简化验证逻辑，移除重复检查
RUN PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')") && \
    export PYTHONPATH="/usr/lib64/python${PYTHON_VERSION}/site-packages:/usr/lib/python${PYTHON_VERSION}/site-packages:${PYTHONPATH:-}" && \
    python3 -c "import gi; print('✓ PyGObject installed correctly')" || \
    { echo "✗ PyGObject verification failed" >&2; exit 1; }

# 修复7：合并测试运行与环境变量设置
RUN set -euxo pipefail; \
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')") && \
    export PYTHONPATH="/usr/lib64/python${PYTHON_VERSION}/site-packages:/usr/lib/python${PYTHON_VERSION}/site-packages:${PYTHONPATH:-}" && \
    TEST_FILE="/root/src/tests/test_gi.py" && \
    if [ ! -f "${TEST_FILE}" ]; then \
        echo "✗ 测试文件不存在: ${TEST_FILE}"; \
        echo "检查 /root/src 目录:"; \
        ls -la /root/src/ || true; \
        echo "检查 /root/src/tests 目录:"; \
        ls -la /root/src/tests/ || true; \
        exit 1; \
    fi && \
    echo "运行测试文件: ${TEST_FILE}" && \
    python3 "${TEST_FILE}"

    
WORKDIR /root/src

# ===== Installing unitree_sdk2 =====
# Build the Unitree SDK:
# Change to the unitree_sdk2 folder, make install.sh executable and run it,
# then create a build directory, run cmake and make.
# Note: unitree_sdk2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "⚠ unitree_sdk2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_sdk2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_sdk2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_sdk2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2; \
      fi; \
    fi; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "✗ unitree_sdk2/CMakeLists.txt not found after initialization"; \
      ls -la unitree_sdk2/ || true; \
      exit 1; \
    fi; \
    echo "✓ unitree_sdk2 submodule ready"

WORKDIR /root/src/unitree_sdk2
# 在构建 unitree_sdk2 之前，确保环境变量正确设置
RUN bash -c "set -euxo pipefail; \
    set +u; \
    source /opt/agiros/${ROS_DISTRO}/setup.bash 2>/dev/null || true; \
    set -u; \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make install"
# ===== Installing unitree_sdk2 =====

# ==================== 构建unitree_ros2 ====================
RUN set -euxo pipefail; \
    if [ ! -d "unitree_ros2" ] || ([ ! -f "unitree_ros2/.git" ] && [ ! -d "unitree_ros2/.git" ]); then \
      echo "⚠ unitree_ros2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_ros2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_ros2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_ros2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2; \
      fi; \
    fi; \
    if [ ! -d "unitree_ros2" ]; then \
      echo "✗ unitree_ros2 directory not found after initialization"; \
      exit 1; \
    fi; \
    echo "✓ unitree_ros2 submodule ready"

WORKDIR /root/src/unitree_ros2/cyclonedds_ws/src
RUN git clone https://github.com/ros2/rmw_cyclonedds -b humble && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    colcon build --packages-select cyclonedds

WORKDIR /root/src/unitree_ros2/cyclonedds_ws
RUN set -euxo pipefail; \
    if [ -f /root/src/agiros_cyclonedds_setup.sh ]; then \
      cp /root/src/agiros_cyclonedds_setup.sh ../setup.sh; \
      chmod +x ../setup.sh; \
    else \
      echo "✗ /root/src/agiros_cyclonedds_setup.sh not found"; \
      ls -la /root/src/agiros_cyclonedds_setup.sh || true; \
      exit 1; \
    fi

# 检查并安装 agirosdep，与 Ubuntu Dockerfile 一致
RUN set -euxo pipefail; \
    if ! command -v agirosdep &> /dev/null; then \
      echo "agirosdep not found, installing explicitly..."; \
      pip3 install --no-cache-dir --break-system-packages \
        http://1.94.193.239/yumrepo/agiros/agirosdep/agirosdep-0.25.1-py3-none-any.whl; \
    else \
      echo "agirosdep is available at: $(which agirosdep)"; \
    fi; \
    which agirosdep

# agirosdep 初始化并安装 unitree_ros2 依赖（跳过已构建的 cyclonedds）
RUN bash -c "set -exo pipefail; \
    set +u; \
    source /opt/agiros/${ROS_DISTRO}/setup.bash; \
    set -u; \
    agirosdep init 2>/dev/null || true; \
    agirosdep update; \
    agirosdep install --from-paths /root/src/unitree_ros2/cyclonedds_ws/src --ignore-src -r -y \
      --skip-keys 'cyclonedds rmw_cyclonedds_cpp' || \
    (echo '⚠ agirosdep install failed, continuing...' && true)"

# 修复8：合并构建步骤，避免重复编译cyclonedds（set +u 避免 SHELL -u 下 source setup.bash 未设变量报错）
RUN bash -c "set +u; source /opt/agiros/${ROS_DISTRO}/setup.bash && colcon build"

# ==================== 最终环境配置 ====================
# 修复9：改用profile.d脚本，更标准且兼容多种shell
RUN PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')") && \
    { \
      echo "source ${AGIROS_INSTALL_BASE}/setup.bash"; \
      echo "export PYTHONPATH=\"/usr/lib64/python${PYTHON_VERSION}/site-packages:/usr/lib/python${PYTHON_VERSION}/site-packages:\${PYTHONPATH:-}\""; \
    } > /etc/profile.d/agiros.sh && \
    chmod +x /etc/profile.d/agiros.sh

ENV ROS_ROOT=${AGIROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    ROS_INSTALL_BASE=${AGIROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${AGIROS_INSTALL_BASE}/lib:${AGIROS_INSTALL_BASE}/lib64:/usr/local/lib:/usr/local/lib64 \
    PATH=${AGIROS_INSTALL_BASE}/bin:${PATH}

CMD ["/bin/bash"]