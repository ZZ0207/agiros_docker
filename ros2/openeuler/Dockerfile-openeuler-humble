# syntax=docker/dockerfile:1
#
# openEuler + ROS 2 Humble (source build) for multi-arch (amd64/arm64).
# Build with:
#   docker buildx build --platform linux/amd64,linux/arm64 -t <name>:humble-openeuler -f ros2/openeuler/Dockerfile-openeuler-humble .
#
# Notes:
# - ROS 2 binaries are not officially released for openEuler, so we build from source.
# - Dependency resolution via rosdep may not fully match openEuler; this Dockerfile attempts rosdep and continues.
#

ARG OPENEULER_TAG=24.03-lts
FROM openeuler/openeuler:${OPENEULER_TAG}

SHELL ["/bin/bash", "-c"]

ARG ROS_DISTRO=humble
ARG ROS_INSTALL_BASE=/opt/ros/${ROS_DISTRO}
ARG ROS2_REPOS_URL=https://raw.githubusercontent.com/ros2/ros2/${ROS_DISTRO}/ros2.repos

# docker buildx will set this automatically (amd64/arm64)
ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DISTRO=${ROS_DISTRO}

WORKDIR /root

# Base build tooling + common ROS2 deps (RPM names are "RHEL-like"; some may vary by openEuler release).
RUN set -euxo pipefail; \
    dnf -y update; \
    dnf -y install \
      bash \
      ca-certificates \
      curl \
      wget \
      git \
      which \
      findutils \
      tar \
      gzip \
      bzip2 \
      unzip \
      make \
      cmake \
      ninja-build \
      gcc \
      gcc-c++ \
      pkgconf-pkg-config \
      python3 \
      python3-pip \
      python3-devel \
      python3-numpy \
      python3-lxml \
      openssl-devel \
      libffi-devel \
      libyaml-devel \
      libuuid-devel \
      libxml2-devel \
      tinyxml2-devel \
      libcurl-devel \
      sqlite-devel \
      && dnf clean all; \
    rm -rf /var/cache/dnf

# Python build + ROS tooling (including rosdep)
RUN set -euxo pipefail; \
    python3 -m pip install --no-cache-dir -U pip setuptools wheel; \
    python3 -m pip install --no-cache-dir -U \
      colcon-common-extensions \
      vcstool \
      rosdep \
      empy \
      catkin_pkg \
      lark \
      pyyaml \
      pytest

# rosdep best-effort init (may fail on minimal containers if already initialized)
RUN set -euxo pipefail; \
    rosdep init || true; \
    rosdep update || true

#添加openEuler的ros2源
RUN dnf config-manager --add-repo https://repo.openeuler.org/openEuler-24.03-LTS/everything/x86_64/os/Packages/ros2.repo

#更新软件源并安装ros2 桌面版
RUN dnf update -y && dnf install -y \
    ros-$ROS_DISTRO-desktop

#安装RViz2和Gazebo
RUN dnf install -y \
    ros-$ROS_DISTRO-rviz2 \
    ros-$ROS_DISTRO-ros-gz

# Default ROS environment for interactive shells
RUN set -euxo pipefail; \
    echo "source ${ROS_INSTALL_BASE}/setup.bash" >> /etc/bashrc

ENV ROS_ROOT=${ROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${ROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${ROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${ROS_INSTALL_BASE}/lib:${ROS_INSTALL_BASE}/lib64 \
    PATH=${ROS_INSTALL_BASE}/bin:${PATH}

CMD ["/bin/bash"]


