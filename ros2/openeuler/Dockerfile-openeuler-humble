# syntax=docker/dockerfile:1
#
# openEuler + ROS 2 Humble (binary installation) for multi-arch (amd64/arm64).
# Build with:
#   docker buildx build --platform linux/amd64,linux/arm64 -t <name>:humble-openeuler -f ros2/openeuler/Dockerfile-openeuler-humble .
#
# Notes:
# - Uses openEuler official ROS Humble binary packages from ROS-SIG repository.
# - Reference: https://docs.openeuler.org/zh/docs/24.03_LTS_SP3/tools/application/ros/installation_and_deployment.html
#

ARG OPENEULER_TAG=24.03-lts
FROM openeuler/openeuler:${OPENEULER_TAG}

SHELL ["/bin/bash", "-c"]

ARG ROS_DISTRO=humble
ARG ROS_INSTALL_BASE=/opt/ros/${ROS_DISTRO}

# docker buildx will set this automatically (amd64/arm64)
ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DISTRO=${ROS_DISTRO}

WORKDIR /root

# Base build tooling + common ROS2 deps (RPM names are "RHEL-like"; some may vary by openEuler release).
RUN set -euxo pipefail; \
    dnf -y update; \
    dnf -y install \
      bash \
      ca-certificates \
      curl \
      wget \
      git \
      findutils \
      tar \
      gzip \
      bzip2 \
      unzip \
      make \
      cmake \
      ninja-build \
      gcc \
      gcc-c++ \
      pkgconf-pkg-config \
      python3 \
      python3-pip \
      python3-devel \
      python3-numpy \
      python3-lxml \
      openssl-devel \
      libffi-devel \
      libyaml-devel \
      libuuid-devel \
      libxml2-devel \
      tinyxml2-devel \
      libcurl-devel \
      sqlite-devel \
      && dnf clean all; \
    rm -rf /var/cache/dnf

# Python build tools (optional, for building custom packages)
RUN set -euxo pipefail; \
    python3 -m pip install --no-cache-dir -U pip setuptools wheel; \
    python3 -m pip install --no-cache-dir -U \
      colcon-common-extensions \
      empy \
      catkin_pkg \
      lark \
      pyyaml

# Configure openEuler ROS Humble repository based on architecture
# Reference: https://docs.openeuler.org/zh/docs/24.03_LTS_SP3/tools/application/ros/installation_and_deployment.html
RUN set -euxo pipefail; \
    ARCH=$(uname -m); \
    if [ "$ARCH" = "x86_64" ]; then \
      printf '[openEulerROS-humble]\nname=openEulerROS-humble\nbaseurl=https://eulermaker.compass-ci.openeuler.openatom.cn/api/ems1/repositories/ROS-SIG-Multi-Version_ros-humble_openEuler-24.03-LTS-TEST4/openEuler%%3A24.03-LTS/x86_64/\nenabled=1\ngpgcheck=0\n' > /etc/yum.repos.d/ROS.repo; \
    elif [ "$ARCH" = "aarch64" ]; then \
      printf '[openEulerROS-humble]\nname=openEulerROS-humble\nbaseurl=https://eulermaker.compass-ci.openeuler.openatom.cn/api/ems1/repositories/ROS-SIG-Multi-Version_ros-humble_openEuler-24.03-LTS-TEST4/openEuler%%3A24.03-LTS/aarch64/\nenabled=1\ngpgcheck=0\n' > /etc/yum.repos.d/ROS.repo; \
    else \
      echo "Unsupported architecture: $ARCH"; \
      exit 1; \
    fi

# Install ROS Humble packages.
# Note: Installing `ros-humble-*` is extremely large and can exceed CI runner disk limits.
# Reference: https://docs.openeuler.org/zh/docs/24.03_LTS_SP3/tools/application/ros/installation_and_deployment.html
ARG ROS_INSTALL_SET=ros-base
RUN set -euxo pipefail; \
    dnf update -y; \
    if [[ "${ROS_INSTALL_SET}" == "all" ]]; then \
      dnf install -y "ros-humble-*" --skip-broken --exclude=ros-humble-generate-parameter-library-example; \
    elif [[ "${ROS_INSTALL_SET}" == "desktop" ]]; then \
      dnf install -y ros-humble-desktop; \
    else \
      dnf install -y ros-humble-ros-base; \
    fi; \
    dnf clean all; \
    rm -rf /var/cache/dnf

# Verify ROS Humble installation
RUN set -euxo pipefail; \
    rpm -q ros-humble-ros-base > /dev/null && echo "✓ ROS Humble installed successfully" || echo "⚠ ROS Humble installation may be incomplete"

# Default ROS environment for interactive shells
RUN set -euxo pipefail; \
    echo "source ${ROS_INSTALL_BASE}/setup.bash" >> /etc/bashrc

ENV ROS_ROOT=${ROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${ROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${ROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${ROS_INSTALL_BASE}/lib:${ROS_INSTALL_BASE}/lib64 \
    PATH=${ROS_INSTALL_BASE}/bin:${PATH}

CMD ["/bin/bash"]


