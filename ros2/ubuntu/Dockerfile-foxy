# Use the official ROS Foxy image as a base (Ubuntu 20.04)
# Official Docker Hub image supports both amd64 and arm64v8 architectures
# Reference: https://hub.docker.com/_/ros/tags?name=foxy
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG ROS_DISTRO=foxy
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}

# Use official ros image (ros:foxy points to ros-foxy-ros-base-focal)
# This supports both amd64 and arm64v8 architectures
FROM ros:foxy-ros-base-focal

# Set bash as the default shell to support pipefail option
SHELL ["/bin/bash", "-c"]

# Re-declare ARG after FROM to make them available in subsequent instructions
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG ROS_DISTRO=foxy
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}

# Set an environment variable for non-interactive installs
ENV DEBIAN_FRONTEND=noninteractive


# Update package lists and install additional packages (e.g., pip and other tools)
RUN apt-get update && apt-get install -y \
    python3-pip \
    iputils-ping \
    git \
    vim \
    ros-foxy-rmw-cyclonedds-cpp \
    ros-foxy-rosidl-generator-dds-idl \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /root

RUN set -euxo pipefail; \
    mkdir -p /root/src
COPY src/ /root/src/

    
# Install RViz2 and Gazebo (may not be available on all architectures)
# Allow installation to fail on unsupported architectures (e.g., arm64)
RUN set +e; \
    apt-get install --no-install-recommends -yqqq \
      ros-$ROS_DISTRO-rviz2 \
      ros-$ROS_DISTRO-ros-gz || \
    (echo "⚠ RViz2/Gazebo packages not available for this architecture, skipping..." && true)

# Optional
#--------------
# Add additional dependencies here as a separate step
# Don't modify above steps, as it will trigger a rebuild

# Non Python/ROS Dependencies
# RUN apt-get install --no-install-recommends -yqqq \
#     vim

# Python Dependencies
# RUN apt-get install --no-install-recommends -yqqq \
#     python-pip

# ROS Dependencies
# RUN apt-get install --no-install-recommends -yqqq \
#     ros-$ROS_DISTRO-xacro


# ===== GStreamer =====
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    libgirepository1.0-dev \
    libcairo2-dev \
    pkg-config \
    gir1.2-gtk-3.0 \
    libgstreamer1.0-dev \
    gir1.2-gstreamer-1.0 \
    && rm -rf /var/lib/apt/lists/*
# Install PyGObject using pip
RUN pip3 install PyGObject
# Run test file to check if PyGObject is installed correctly
WORKDIR /root/src
RUN python3 tests/test_gi.py
# ===== GStreamer =====



# ===== Installing unitree_sdk2 =====
# Build the Unitree SDK:
# Change to the unitree_sdk2 folder, make install.sh executable and run it,
# then create a build directory, run cmake and make.
WORKDIR /root/src/unitree_sdk2
RUN mkdir build && \
    cd build && \
    cmake .. && \
    sudo make install
# ===== Installing unitree_sdk2 =====


# ===== Installing unitree_ros2 =====
# Following https://github.com/unitreerobotics/unitree_ros2
# To get unitree_ros2 installed.
WORKDIR /root/src/unitree_ros2/cyclonedds_ws/src
RUN git clone https://github.com/ros2/rmw_cyclonedds -b foxy && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    colcon build --packages-select cyclonedds
# Now, source the ROS2 environment and build the rest of the packages,
# skipping cyclone‑dds (which has already been built)
WORKDIR /root/src/unitree_ros2/cyclonedds_ws
RUN bash -c "source /opt/ros/foxy/setup.bash && \
             pwd && \
             colcon build"
# Double check whether the build was successful
RUN ls -l /root/src/unitree_ros2/cyclonedds_ws
# ===== Installing unitree_ros2 =====

# Create a dedicated directory for your application code
WORKDIR /root/src

# Ensure that docker_internal_setup.sh is executable
RUN chmod +x /root/src/docker_internal_setup.sh && echo "source /root/src/docker_internal_setup.sh" >> /etc/bashrc

ENV ROS_ROOT=${AGIROS_INSTALL_BASE} \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_INSTALL_BASE=${AGIROS_INSTALL_BASE} \
    AGIROS_INSTALL_BASE=${AGIROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${AGIROS_INSTALL_BASE}/lib:${AGIROS_INSTALL_BASE}/lib64 \
    PATH=${AGIROS_INSTALL_BASE}/bin:${PATH}

# Set the entrypoint to start your application
ENTRYPOINT ["./docker_internal_setup.sh"]
CMD ["bash"]