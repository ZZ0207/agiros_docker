# ===== Installing unitree_sdk2 =====
# Build the Unitree SDK:
# Change to the unitree_sdk2 folder, make install.sh executable and run it,
# then create a build directory, run cmake and make.
# Note: unitree_sdk2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "⚠ unitree_sdk2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_sdk2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_sdk2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_sdk2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2; \
      fi; \
    fi; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "✗ unitree_sdk2/CMakeLists.txt not found after initialization"; \
      ls -la unitree_sdk2/ || true; \
      exit 1; \
    fi; \
    echo "✓ unitree_sdk2 submodule ready"

WORKDIR /root/src/unitree_sdk2
RUN mkdir build && \
    cd build && \
    cmake .. && \
    make install
# ===== Installing unitree_sdk2 =====


# ===== Installing unitree_ros2 =====
# Following https://github.com/unitreerobotics/unitree_ros2
# To get unitree_ros2 installed.
# Note: unitree_ros2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -d "unitree_ros2" ] || ([ ! -f "unitree_ros2/.git" ] && [ ! -d "unitree_ros2/.git" ]); then \
      echo "⚠ unitree_ros2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_ros2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_ros2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_ros2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2; \
      fi; \
    fi; \
    if [ ! -d "unitree_ros2" ]; then \
      echo "✗ unitree_ros2 directory not found after initialization"; \
      exit 1; \
    fi; \
    echo "✓ unitree_ros2 submodule ready"


WORKDIR /root/src/unitree_ros2/cyclonedds_ws/src
RUN git clone https://github.com/ros2/rmw_cyclonedds -b humble && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    colcon build --packages-select cyclonedds
# Now, source the ROS2 environment and build the rest of the packages,


WORKDIR /root/src/unitree_ros2/cyclonedds_ws

# 修改默认的setup.sh文件，拷贝到/root/src/unitree_ros2/setup.sh
RUN set -euxo pipefail; \
    if [ -f /root/src/ros_cyclonedds_setup.sh ]; then \
      cp /root/src/ros_cyclonedds_setup.sh /root/src/unitree_ros2/setup.sh; \
      chmod +x /root/src/unitree_ros2/setup.sh; \
    else \
      echo "✗ /root/src/ros_cyclonedds_setup.sh not found"; \
      ls -la /root/src/ros_cyclonedds_setup.sh || true; \
      exit 1; \
    fi

# 修复 empy 包冲突问题（确保使用正确的 empy 版本）
RUN set -euxo pipefail; \
    echo "=== 修复 empy 包问题 ==="; \
    pip3 uninstall -y em 2>/dev/null || true; \
    pip3 install --no-cache-dir --force-reinstall empy==3.3.4 || \
    pip3 install --no-cache-dir --force-reinstall empy; \
    python3 -c "import em; print(f'✓ empy version: {em.__version__ if hasattr(em, \"__version__\") else \"unknown\"}')" || \
    (echo "⚠ empy 验证失败，但继续..." && true)

# 安装所有 ROS 依赖（关键修复！必须在构建前执行）
RUN bash -c "set -exo pipefail; \
    set +u; \
    source /opt/ros/humble/setup.bash; \
    set -u; \
    rosdep init 2>/dev/null || true; \
    rosdep update; \
    rosdep install --from-paths src --ignore-src -r -y \
      --skip-keys 'cyclonedds rmw_cyclonedds_cpp'"

# 对于ARM64架构，确保安装了所有必要的开发库
RUN set -euxo pipefail; \
    if [ "$(uname -m)" = "aarch64" ]; then \
        echo "=== 为ARM64架构安装额外的开发库 ==="; \
        apt-get update && \
        apt-get install -y --no-install-recommends \
          ros-humble-builtin-interfaces \
          ros-humble-rosidl-generator-c \
          ros-humble-rosidl-typesupport-c \
          ros-humble-rosidl-typesupport-introspection-c \
          ros-humble-rosidl-runtime-c || \
        (echo "⚠ 某些包可能已安装或不可用，继续..." && true); \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
        echo "验证关键库文件安装:"; \
        for lib in builtin_interfaces__rosidl_generator_c rosidl_typesupport_c rosidl_runtime_c; do \
            if find /opt/ros/humble -name "lib${lib}.so*" -type f 2>/dev/null | grep -q .; then \
                echo "  ✓ 找到 lib${lib}.so"; \
            else \
                echo "  ✗ 未找到 lib${lib}.so"; \
            fi; \
        done; \
    fi

# 在 Dockerfile 的 colcon build 步骤之前插入
# 修复ARM64架构ROS库路径问题
RUN set -euxo pipefail; \
    if [ "$(uname -m)" = "aarch64" ]; then \
        echo "=== 正在修复ARM64架构ROS库路径 ==="; \
        ARCH_LIB_DIR="/opt/ros/humble/lib/aarch64-linux-gnu"; \
        if [ -d "${ARCH_LIB_DIR}" ]; then \
            echo "找到架构库目录: ${ARCH_LIB_DIR}"; \
            # 首先，修复所有在该目录下的.so文件
            find "${ARCH_LIB_DIR}" -maxdepth 1 -name "*.so" -type f 2>/dev/null | while read -r LIB_FILE; do \
                LIBNAME=$(basename "${LIB_FILE}"); \
                TARGET="/opt/ros/humble/lib/${LIBNAME}"; \
                if [ ! -e "${TARGET}" ] && [ ! -L "${TARGET}" ]; then \
                    echo "创建链接: ${LIBNAME}"; \
                    ln -sf "aarch64-linux-gnu/${LIBNAME}" "${TARGET}"; \
                fi; \
            done; \
            # 特别检查关键库是否存在
            echo "检查关键库文件:"; \
            for LIB in builtin_interfaces__rosidl_generator_c \
                       builtin_interfaces__rosidl_typesupport_c \
                       builtin_interfaces__rosidl_typesupport_introspection_c \
                       rosidl_typesupport_c \
                       rosidl_runtime_c; do \
                LIB_FILE="${ARCH_LIB_DIR}/lib${LIB}.so"; \
                LINK_FILE="/opt/ros/humble/lib/lib${LIB}.so"; \
                if [ -f "${LIB_FILE}" ]; then \
                    if [ ! -e "${LINK_FILE}" ]; then \
                        echo "创建关键库链接: lib${LIB}.so"; \
                        ln -sf "aarch64-linux-gnu/lib${LIB}.so" "${LINK_FILE}"; \
                    else \
                        echo "关键库已存在: lib${LIB}.so"; \
                    fi; \
                else \
                    echo "警告: 库文件不存在: ${LIB_FILE}"; \
                    # 尝试查找库文件的实际位置
                    FOUND=$(find /opt/ros/humble -name "lib${LIB}.so*" -type f 2>/dev/null | head -1); \
                    if [ -n "${FOUND}" ]; then \
                        echo "  在以下位置找到: ${FOUND}"; \
                    else \
                        echo "  未找到 lib${LIB}.so 的任何位置"; \
                    fi; \
                fi; \
            done; \
            echo "库路径修复完成。"; \
            # 验证关键库是否可访问
            echo "验证关键库链接:"; \
            for LIB in builtin_interfaces__rosidl_generator_c; do \
                LINK_FILE="/opt/ros/humble/lib/lib${LIB}.so"; \
                if [ -e "${LINK_FILE}" ] || [ -L "${LINK_FILE}" ]; then \
                    echo "✓ ${LINK_FILE} 存在"; \
                    ls -la "${LINK_FILE}" || true; \
                else \
                    echo "✗ ${LINK_FILE} 不存在"; \
                fi; \
            done; \
        else \
            echo "警告：未找到预期的架构库目录 ${ARCH_LIB_DIR}"; \
            echo "搜索所有可能的库位置:"; \
            find /opt/ros/humble -type d -name "*aarch64*" 2>/dev/null | head -5 || true; \
        fi; \
    fi

# skipping cyclone‑dds (which has already been built)
WORKDIR /root/src/unitree_ros2/cyclonedds_ws
# 构建前最后一次修复ARM64库路径（确保所有链接都已创建）
RUN set -euxo pipefail; \
    if [ "$(uname -m)" = "aarch64" ]; then \
        echo "=== 构建前最终ARM64库路径修复 ==="; \
        ARCH_LIB_DIR="/opt/ros/humble/lib/aarch64-linux-gnu"; \
        if [ -d "${ARCH_LIB_DIR}" ]; then \
            # 强制重新创建所有关键库的链接
            for LIB in builtin_interfaces__rosidl_generator_c \
                       builtin_interfaces__rosidl_typesupport_c \
                       builtin_interfaces__rosidl_typesupport_introspection_c \
                       rosidl_typesupport_c \
                       rosidl_runtime_c; do \
                LIB_FILE="${ARCH_LIB_DIR}/lib${LIB}.so"; \
                LINK_FILE="/opt/ros/humble/lib/lib${LIB}.so"; \
                if [ -f "${LIB_FILE}" ]; then \
                    # 如果链接已存在，先删除再创建
                    rm -f "${LINK_FILE}"; \
                    ln -sf "aarch64-linux-gnu/lib${LIB}.so" "${LINK_FILE}"; \
                    echo "✓ 创建/更新链接: lib${LIB}.so"; \
                else \
                    echo "⚠ 库文件不存在: ${LIB_FILE}"; \
                    # 尝试在整个ROS目录中查找
                    FOUND=$(find /opt/ros/humble -name "lib${LIB}.so*" -type f 2>/dev/null | head -1); \
                    if [ -n "${FOUND}" ]; then \
                        echo "  在以下位置找到: ${FOUND}"; \
                        # 如果找到在其他位置，创建链接
                        REL_PATH=$(realpath --relative-to="/opt/ros/humble/lib" "${FOUND}" 2>/dev/null || echo "${FOUND#/opt/ros/humble/lib/}"); \
                        rm -f "${LINK_FILE}"; \
                        ln -sf "${REL_PATH}" "${LINK_FILE}"; \
                        echo "  创建链接到: ${REL_PATH}"; \
                    fi; \
                fi; \
            done; \
            # 验证所有关键库链接
            echo "验证关键库链接:"; \
            for LIB in builtin_interfaces__rosidl_generator_c; do \
                LINK_FILE="/opt/ros/humble/lib/lib${LIB}.so"; \
                if [ -L "${LINK_FILE}" ] && [ -e "${LINK_FILE}" ]; then \
                    echo "  ✓ ${LINK_FILE} -> $(readlink -f "${LINK_FILE}")"; \
                elif [ -f "${LINK_FILE}" ]; then \
                    echo "  ✓ ${LINK_FILE} (文件)"; \
                else \
                    echo "  ✗ ${LINK_FILE} 不存在或损坏"; \
                fi; \
            done; \
        fi; \
    fi

# 构建unitree_ros2包
WORKDIR /root/src/unitree_ros2/cyclonedds_ws
RUN bash -c "set -exo pipefail; \
    set +u; \
    source /opt/ros/humble/setup.bash; \
    # 如果 cyclonedds 已构建，source 其安装目录
    if [ -f /root/src/unitree_ros2/cyclonedds_ws/install/setup.bash ]; then \
      source /root/src/unitree_ros2/cyclonedds_ws/install/setup.bash; \
    fi; \
    set -u; \
    # 确保库路径包含架构特定目录
    if [ \"\$(uname -m)\" = \"aarch64\" ] && [ -d \"/opt/ros/humble/lib/aarch64-linux-gnu\" ]; then \
        export LD_LIBRARY_PATH=\"/opt/ros/humble/lib/aarch64-linux-gnu:\${LD_LIBRARY_PATH:-}\"; \
        echo \"设置LD_LIBRARY_PATH包含架构特定目录\"; \
    fi; \
    # 验证关键库是否可访问
    if [ \"\$(uname -m)\" = \"aarch64\" ]; then \
        echo \"最终验证库文件可访问性:\"; \
        for lib in builtin_interfaces__rosidl_generator_c rosidl_typesupport_c rosidl_runtime_c; do \
            if [ -e \"/opt/ros/humble/lib/lib\${lib}.so\" ] || [ -L \"/opt/ros/humble/lib/lib\${lib}.so\" ]; then \
                echo \"  ✓ lib\${lib}.so 可访问\"; \
                ls -la \"/opt/ros/humble/lib/lib\${lib}.so\" || true; \
            else \
                echo \"  ✗ lib\${lib}.so 不可访问\"; \
                echo \"  搜索所有位置:\"; \
                find /opt/ros/humble -name \"lib\${lib}.so*\" 2>/dev/null | head -3 || echo \"  未找到\"; \
            fi; \
        done; \
    fi; \
    pwd; \
    colcon build --executor sequential --symlink-install"
# Double check whether the build was successful
RUN ls -l /root/src/unitree_ros2/cyclonedds_ws
# ===== Installing unitree_ros2 =====

