# Use the official ROS Humble image as a base (Ubuntu 22.04)
# Official Docker Hub image supports both amd64 and arm64v8 architectures
# Reference: https://hub.docker.com/_/ros/tags?name=humble
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG ROS_DISTRO=humble
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}

# Use official ros image (ros:humble points to ros-humble-ros-base-jammy)
# This supports both amd64 and arm64v8 architectures
FROM ros:humble-ros-base-jammy

# Set bash as the default shell to support pipefail option
SHELL ["/bin/bash", "-c"]

# Re-declare ARG after FROM to make them available in subsequent instructions
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG ROS_DISTRO=humble
ARG AGIROS_INSTALL_BASE=/opt/agiros/${ROS_DISTRO}

# Set an environment variable for non-interactive installs
ENV DEBIAN_FRONTEND=noninteractive

# Update package lists and install additional packages (e.g., pip and other tools)
# Install ROS2 development packages needed for building custom packages
RUN apt-get update && apt-get install -y \
    python3-pip \
    iputils-ping \
    git \
    vim \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rosidl-generator-dds-idl \
    ros-humble-rosidl-generator-c \
    ros-humble-rosidl-generator-cpp \
    ros-humble-rosidl-default-generators \
    ros-humble-rosidl-default-runtime \
    ros-humble-rosidl-typesupport-c \
    ros-humble-rosidl-typesupport-cpp \
    ros-humble-rosidl-typesupport-introspection-c \
    ros-humble-rosidl-typesupport-introspection-cpp \
    ros-humble-builtin-interfaces \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root

RUN set -euxo pipefail; \
    mkdir -p /root/src
COPY src/ /root/src/


# Install RViz2 and Gazebo (may not be available on all architectures)
# Allow installation to fail on unsupported architectures (e.g., arm64)
RUN set +e; \
    apt-get install --no-install-recommends -yqqq \
      ros-$ROS_DISTRO-rviz2 \
      ros-$ROS_DISTRO-ros-gz || \
    (echo "⚠ RViz2/Gazebo packages not available for this architecture, skipping..." && true)

# Optional
#--------------
# Add additional dependencies here as a separate step
# Don't modify above steps, as it will trigger a rebuild

# Non Python/ROS Dependencies
# RUN apt-get install --no-install-recommends -yqqq \
#     vim

# Python Dependencies
# RUN apt-get install --no-install-recommends -yqqq \
#     python-pip

# ROS Dependencies
# RUN apt-get install --no-install-recommends -yqqq \
#     ros-$ROS_DISTRO-xacro

# ===== GStreamer =====
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    libgirepository1.0-dev \
    libcairo2-dev \
    pkg-config \
    gir1.2-gtk-3.0 \
    libgstreamer1.0-dev \
    gir1.2-gstreamer-1.0 \
    && rm -rf /var/lib/apt/lists/*

# Install PyGObject - try system package first, fallback to pip with build dependencies
RUN set -euxo pipefail; \
    if apt-cache show python3-gi 2>/dev/null | grep -q "Package: python3-gi"; then \
      echo "Installing python3-gi from system packages..."; \
      apt-get update && apt-get install -y --no-install-recommends python3-gi && \
      rm -rf /var/lib/apt/lists/*; \
    else \
      echo "python3-gi not available in repos, installing PyGObject via pip with build dependencies..."; \
      apt-get update && apt-get install -y --no-install-recommends \
        meson \
        ninja-build \
        python3-setuptools \
        && rm -rf /var/lib/apt/lists/*; \
      pip3 install --no-cache-dir PyGObject; \
    fi
# Run test file to check if PyGObject is installed correctly
WORKDIR /root/src
RUN python3 tests/test_gi.py
# ===== GStreamer =====


# ===== Installing unitree_sdk2 =====
# Build the Unitree SDK:
# Change to the unitree_sdk2 folder, make install.sh executable and run it,
# then create a build directory, run cmake and make.
# Note: unitree_sdk2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "⚠ unitree_sdk2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_sdk2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_sdk2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_sdk2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_sdk2.git unitree_sdk2; \
      fi; \
    fi; \
    if [ ! -f "unitree_sdk2/CMakeLists.txt" ]; then \
      echo "✗ unitree_sdk2/CMakeLists.txt not found after initialization"; \
      ls -la unitree_sdk2/ || true; \
      exit 1; \
    fi; \
    echo "✓ unitree_sdk2 submodule ready"

WORKDIR /root/src/unitree_sdk2
RUN mkdir build && \
    cd build && \
    cmake .. && \
    make install
# ===== Installing unitree_sdk2 =====


# ===== Installing unitree_ros2 =====
# Following https://github.com/unitreerobotics/unitree_ros2
# To get unitree_ros2 installed.
# Note: unitree_ros2 is a git submodule, ensure it's properly initialized
WORKDIR /root/src
RUN set -euxo pipefail; \
    if [ ! -d "unitree_ros2" ] || ([ ! -f "unitree_ros2/.git" ] && [ ! -d "unitree_ros2/.git" ]); then \
      echo "⚠ unitree_ros2 submodule not found, initializing..."; \
      if [ -f ".gitmodules" ]; then \
        git submodule update --init --recursive unitree_ros2 || \
        (echo "⚠ Git submodule init failed, cloning directly..." && \
         rm -rf unitree_ros2 && \
         git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2); \
      else \
        echo "⚠ .gitmodules not found, cloning directly..."; \
        rm -rf unitree_ros2; \
        git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git unitree_ros2; \
      fi; \
    fi; \
    if [ ! -d "unitree_ros2" ]; then \
      echo "✗ unitree_ros2 directory not found after initialization"; \
      exit 1; \
    fi; \
    echo "✓ unitree_ros2 submodule ready"


WORKDIR /root/src/unitree_ros2/cyclonedds_ws/src
RUN git clone https://github.com/ros2/rmw_cyclonedds -b humble && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && \
    cd .. && \
    colcon build --packages-select cyclonedds
# Now, source the ROS2 environment and build the rest of the packages,


WORKDIR /root/src/unitree_ros2/cyclonedds_ws

# 安装所有 ROS 依赖（关键修复！必须在构建前执行）
RUN bash -c "set -exo pipefail; \
    # ROS 2 setup脚本与set -u不兼容，临时禁用
    set +u; \
    source /opt/ros/humble/setup.bash; \
    # 重新启用严格模式
    set -u; \
    rosdep init 2>/dev/null || true; \
    rosdep update; \
    # 安装 workspace 中所有包的依赖，跳过已构建的 cyclonedds 和 rmw_cyclonedds_cpp
    rosdep install --from-paths src --ignore-src -r -y \
      --skip-keys 'cyclonedds rmw_cyclonedds_cpp'"

# ===== 修复 ARM64 架构下的库路径问题 - 增强版 =====
# 在构建前确保所有必要的符号链接都已创建
RUN set -euxo pipefail; \
    # 需要修复的库列表
    LIBS_TO_FIX=( \
        "libbuiltin_interfaces__rosidl_generator_c.so" \
        "libbuiltin_interfaces__rosidl_typesupport_c.so" \
        "libbuiltin_interfaces__rosidl_typesupport_cpp.so" \
        "libbuiltin_interfaces__rosidl_typesupport_introspection_c.so" \
        "libbuiltin_interfaces__rosidl_typesupport_introspection_cpp.so" \
    ); \
    for LIB_NAME in "${LIBS_TO_FIX[@]}"; do \
        TARGET_PATH="/opt/ros/humble/lib/${LIB_NAME}"; \
        if [ ! -e "${TARGET_PATH}" ]; then \
            echo "⚠ ${TARGET_PATH} not found, searching for ${LIB_NAME}..."; \
            # 在 /opt/ros/humble/lib 下所有子目录中搜索
            FOUND_LIB=$(find /opt/ros/humble/lib -name "${LIB_NAME}" -type f 2>/dev/null | head -n 1); \
            if [ -n "${FOUND_LIB}" ]; then \
                echo "✓ Found library at: ${FOUND_LIB}"; \
                mkdir -p /opt/ros/humble/lib; \
                ln -sf "$(realpath --relative-to=/opt/ros/humble/lib "${FOUND_LIB}")" "${TARGET_PATH}"; \
                # 验证链接是否成功
                if [ ! -L "${TARGET_PATH}" ] || [ ! -e "$(readlink -f "${TARGET_PATH}")" ]; then \
                    echo "✗ Symbolic link validation failed!"; \
                    ls -la "${TARGET_PATH}" || true; \
                    exit 1; \
                fi; \
                echo "✓ Symlink created: ${TARGET_PATH} → $(readlink -f "${TARGET_PATH}")"; \
            else \
                echo "✗ ERROR: ${LIB_NAME} not found anywhere!"; \
                echo "Searching for ${LIB_NAME} files:"; \
                find /opt/ros/humble -name "*${LIB_NAME}*" -type f 2>/dev/null || true; \
                exit 1; \
            fi; \
        else \
            echo "✓ ${TARGET_PATH} already exists"; \
        fi; \
    done
# ===== 修复 ARM64 架构下的库路径问题 =====


# skipping cyclone‑dds (which has already been built)
WORKDIR /root/src/unitree_ros2/cyclonedds_ws
RUN bash -c "source /opt/ros/humble/setup.bash && \
            pwd && \
            colcon build"
# Double check whether the build was successful
RUN ls -l /root/src/unitree_ros2/cyclonedds_ws
# ===== Installing unitree_ros2 =====

# Create a dedicated directory for your application code
WORKDIR /root/src

# Ensure that docker_internal_setup.sh is executable
RUN chmod +x /root/src/docker_internal_setup.sh && echo "source /root/src/docker_internal_setup.sh" >> /etc/bashrc

ENV ROS_ROOT=${AGIROS_INSTALL_BASE} \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_INSTALL_BASE=${AGIROS_INSTALL_BASE} \
    AGIROS_INSTALL_BASE=${AGIROS_INSTALL_BASE} \
    AMENT_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    CMAKE_PREFIX_PATH=${AGIROS_INSTALL_BASE} \
    LD_LIBRARY_PATH=${AGIROS_INSTALL_BASE}/lib:${AGIROS_INSTALL_BASE}/lib64 \
    PATH=${AGIROS_INSTALL_BASE}/bin:${PATH}

# Set the entrypoint to start your application
ENTRYPOINT ["./docker_internal_setup.sh"]
CMD ["bash"]