#!/bin/bash
# qemu-ldconfig-fix
set -e
ACTION="${1:-enable}"

# 获取架构并转换为 openEuler 格式
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)
        exit 0  # x86_64 架构直接退出
        ;;
    aarch64|riscv64)
        # ARM64 和 RISC-V 架构继续执行
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac

# 后续 ldconfig 操作保持不变...
if [ "$ACTION" = "enable" ]; then
    if [ -f /usr/sbin/ldconfig.real ]; then
        cp -a /usr/sbin/ldconfig.real /usr/sbin/ldconfig
    else
        cp -a /usr/sbin/ldconfig /usr/sbin/ldconfig.real
    fi
    printf '#!/bin/sh\nexit 0\n' > /usr/sbin/ldconfig
    chmod +x /usr/sbin/ldconfig
elif [ "$ACTION" = "disable" ]; then
    if [ -f /usr/sbin/ldconfig.real ]; then
        mv /usr/sbin/ldconfig.real /usr/sbin/ldconfig
    fi
fi